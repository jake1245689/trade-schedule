# Copy this file to .env and fill in your own values before running in production.

# Secret used to sign login sessions (JWTs). Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on.
PORT=3001

# Set to "true" only if the app is deployed behind HTTPS (recommended in production).
# This makes login cookies "secure" so browsers only send them over HTTPS.
COOKIE_SECURE=false
